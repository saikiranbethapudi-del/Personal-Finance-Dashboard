    {
      "name": "Transactions",
      "item": [
        {
          "name": "1. Create Transaction",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const response = pm.response.json();",
                  "if (response.success && response.data && response.data.transaction && response.data.transaction._id) {",
                  "    pm.collectionVariables.set('transactionId', response.data.transaction._id);",
                  "    console.log('transactionId captured and set:', response.data.transaction._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Grocery Shopping\",\n  \"amount\": 2500,\n  \"type\": \"expense\",\n  \"category\": \"Groceries\",\n  \"date\": \"2026-09-26\",\n  \"paymentMethod\": \"Credit Card\",\n  \"description\": \"Weekly supermarket essentials\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/transactions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions"]
            },
            "description": "Creates a new transaction document in MongoDB."
